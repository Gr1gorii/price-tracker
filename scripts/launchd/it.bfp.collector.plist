<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>it.bfp.collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__RUN_LOCAL__</string>
  </array>
  <!-- every hour at minute 5; missed firings during sleep run on wake -->
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>5</integer></dict>
  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
